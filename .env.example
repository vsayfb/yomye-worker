# APP
APP_ENV=development
SERVICE_NAME=categorization-worker
AWS_REGION=us-east-1

# DB
DB_HOST=postgres-svc
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=gigpf
DB_SSLMODE=disable

#SERVER
OTEL_COLLECTOR_ADDR=otel-collector:4317
METRICS_SERVER_PORT=:9100

# AI
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=replace-with-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=replace-with-groq-model

OPEN_ROUTER_API_KEY=replace-with-openrouter-api-key
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_MODEL=replace-with-openrouter-model

MISTRAL_API_KEY=replace-with-mistral-api-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=replace-with-mistral-model

NVIDIA_API_KEY=replace-with-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=replace-with-nvidia-model

HUGGINGFACE_AI_MODEL=all-minilm:l12-v2
LOCAL_OLLAMA_ENDPOINT=http://host.docker.internal:11434
PROMPT_FILE=./internal/prompter/prompts/profession.txt


# Dev-Only
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SQS_ENDPOINT=http://localstack:4566
CATEGORIZATION_SQS_URL=http://localstack:4566/000000000000/gig-category-events
NOTIFICATION_SQS_URL=http://localstack:4566/000000000000/gig-notification-events
